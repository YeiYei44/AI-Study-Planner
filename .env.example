# Copy to .env and adjust. All keys are prefixed ASP_.

ASP_CANVAS_BASE_URL=https://fultonschools.instructure.com
ASP_HEADLESS=true

# `estimate-llm` and `ask` (the tutor) both need one of these backends —
# not needed for Canvas sync. Pick one via ASP_LLM_BACKEND. Each backend
# uses a cheaper/faster model for estimate-llm and a stronger one for the
# tutor by default (see ASP_LLM_TUTOR_MODEL / ASP_OPENAI_COMPAT_TUTOR_MODEL
# below) — estimating minutes from a description is simple and high-volume;
# tutoring is a harder task that benefits more from a stronger model.
# ASP_LLM_BACKEND=claude

# -- claude (highest quality, costs money) --
# ASP_ANTHROPIC_API_KEY=sk-ant-...
# ASP_LLM_ESTIMATE_MODEL=claude-haiku-4-5-20251001
# ASP_LLM_TUTOR_MODEL=claude-sonnet-5

# -- openai_compat: free-tier cloud, e.g. Groq (recommended — fast, generous
# free limits) or Mistral's La Plateforme, OpenRouter, GitHub Models, or a
# local Ollama server if you'd rather use that than llama-cpp-python below.
# Get a free key at console.groq.com. Model names change over time —
# confirmed working as of this writing; check https://console.groq.com/docs/models
# (or `GET /openai/v1/models` with your key) if either 400s or 404s on you.
# ASP_OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
# ASP_OPENAI_COMPAT_API_KEY=gsk_...
# ASP_OPENAI_COMPAT_MODEL=openai/gpt-oss-20b
# ASP_OPENAI_COMPAT_TUTOR_MODEL=openai/gpt-oss-120b

# -- local: fully offline, llama-cpp-python, no network at all. Point at
# a local .gguf file (an 8B-class instruct model — Llama 3.1 8B Instruct
# or Qwen2.5 7B Instruct both work well). Install first:
#   pip install -e ".[local]"
# ASP_LLAMACPP_MODEL_PATH=/path/to/model.gguf

# Embeddings (material search, used by `ask`) always run locally via
# fastembed regardless of ASP_LLM_BACKEND — no config needed, no API key,
# nothing to set here.
